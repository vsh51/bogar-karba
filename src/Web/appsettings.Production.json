{
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Error"
        }
    },

    "Cache": {
        "PublishedChecklistMinutes": 60
    },

    "Notifications": {
        "PollingIntervalSeconds": 10,
        "MaxConnections": 50
    },

    "RateLimiting": {
        "Policies": {
            "Home":     { "MaxRequests": 120, "WindowSeconds": 30 },
            "Login":    { "MaxRequests": 10,  "WindowSeconds": 60 },
            "Register": { "MaxRequests": 5,   "WindowSeconds": 300 }
        }
    }
}
