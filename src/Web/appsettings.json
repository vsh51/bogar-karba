{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    "AllowedHosts": "*",

    "Checklist": {
        "TitleMaxLength": 200,
        "SectionNameMaxLength": 100,
        "SearchMinLength": 2,
        "MaxDeadlineYears": 3
    },

    "Authentication": {
        "CookieExpirationHours": 2
    },

    "Cache": {
        "PublishedChecklistMinutes": 10
    },

    "RateLimiting": {
        "Policies": {
            "Home": { "MaxRequests": 3, "WindowSeconds": 30 },
            "Login": { "MaxRequests": 2, "WindowSeconds": 30 },
            "Register": { "MaxRequests": 2, "WindowSeconds": 60 }
        }
    }
}
