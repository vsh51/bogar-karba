@model Web.Models.Author.AuthorChecklistsViewModel

@{
    ViewData["Title"] = "Author's Page";
}

<div class="bk-container bk-container--narrow mt-4 mb-5">
    <div class="bk-page-header bk-page-header--flush">
        <h1>Your checklists</h1>
        <p>Manage your authored checklists.</p>
    </div>

    @if (!Model.Checklists.Any())
    {
        <div class="card border-dashed bg-secondary-soft text-center py-5 shadow-sm">
            <div class="card-body">
                <i class="bi bi-clipboard-plus text-muted fs-1 mb-3 d-block"></i>
                <p class="mb-0 text-muted">You don't have any checklists yet. Create your first one below.</p>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model.Checklists)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="me-auto">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <h2 class="h6 mb-0 fw-bold">
                                        <a href="@Url.Action("Show", "Checklist", new { id = item.Id })" class="text-decoration-none text-dark">@item.Title</a>
                                    </h2>
                                    @if (!item.IsActive)
                                    {
                                        <span class="badge bg-secondary-soft text-secondary small">inactive</span>
                                    }
                                    @if (!item.IsPublic)
                                    {
                                        <span class="badge bg-secondary-soft text-secondary small">private</span>
                                    }
                                    @if (item.IsPublic && !item.IsEmbeddable)
                                    {
                                        <span class="badge bg-secondary-soft text-secondary small">embed disabled</span>
                                    }
                                    @if (item.Deadline.HasValue)
                                    {
                                        var deadlineIso = item.Deadline.Value.ToString("yyyy-MM-dd");
                                        var badgeClass = item.IsOutdated ? "bg-danger-soft text-danger" : "bg-light text-muted";
                                        <span class="badge @badgeClass fw-normal border">
                                            <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>
                                            <time datetime="@deadlineIso" data-deadline="@deadlineIso">@item.Deadline.Value.ToString("yyyy-MM-dd")</time>
                                            <span class="ms-1 opacity-75">· @item.DeadlineRemaining</span>
                                        </span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <p class="text-muted small mb-0">@item.Description</p>
                                }
                            </div>

                            <div class="dropdown">
                                <button class="btn btn-link text-muted p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical fs-5"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><a class="dropdown-item" href="@Url.Action("Edit", "Checklist", new { id = item.Id })"><i class="bi bi-pencil me-2"></i> Edit checklist</a></li>
                                    <li>
                                        <form asp-action="Clone" asp-controller="Author" asp-route-id="@item.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item"><i class="bi bi-files me-2"></i> Clone checklist</button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-controller="Checklist" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this checklist?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash3 me-2"></i> Delete checklist</button>
                                        </form>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    @if (!item.IsActive)
                                    {
                                        <li>
                                            <form asp-controller="Author" asp-action="Activate" asp-route-id="@item.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item"><i class="bi bi-play-circle me-2"></i> Activate checklist</button>
                                            </form>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <form asp-controller="Author" asp-action="Deactivate" asp-route-id="@item.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item"><i class="bi bi-pause-circle me-2"></i> Deactivate checklist</button>
                                            </form>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    @if (!item.IsPublic)
                                    {
                                        <li>
                                            <form asp-controller="Author" asp-action="MakePublic" asp-route-id="@item.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item"><i class="bi bi-globe me-2"></i> Make public</button>
                                            </form>
                                        </li>
                                        <li>
                                            <button type="button" class="dropdown-item"
                                                    data-bs-toggle="modal" data-bs-target="#access-modal"
                                                    data-checklist-id="@item.Id"
                                                    data-checklist-title="@item.Title">
                                                <i class="bi bi-people me-2"></i> Manage access
                                            </button>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <form asp-controller="Author" asp-action="MakePrivate" asp-route-id="@item.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item"><i class="bi bi-lock me-2"></i> Make private</button>
                                            </form>
                                        </li>
                                        @if (item.IsEmbeddable)
                                        {
                                            <li>
                                                <form asp-controller="Author" asp-action="DisableEmbed" asp-route-id="@item.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item"><i class="bi bi-code-slash me-2"></i> Disable iframe embed</button>
                                                </form>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <form asp-controller="Author" asp-action="EnableEmbed" asp-route-id="@item.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item"><i class="bi bi-code-slash me-2"></i> Enable iframe embed</button>
                                                </form>
                                            </li>
                                        }
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="#" onclick="if (window.checklistProgressSync) { window.checklistProgressSync.copyShareLinkToClipboard('@item.Id'); } return false;"><i class="bi bi-share me-2"></i> Get shareable link</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-4 d-flex flex-wrap gap-2">
        <a href="@Url.Action("Create", "Checklist")" class="btn btn-outline-secondary">
            <i class="bi bi-plus-lg me-1"></i> Create new checklist
        </a>
        <a href="@Url.Action("QuickCreate", "Checklist")" class="btn btn-outline-primary">
            <i class="bi bi-magic me-1"></i> Quick create from text
        </a>
    </div>
</div>

<div class="modal fade" id="access-modal" tabindex="-1" aria-labelledby="access-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="access-modal-label">Manage access</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Html.AntiForgeryToken()

                <p class="text-muted small mb-3" id="access-modal-subtitle"></p>

                <div class="d-flex gap-2 mb-2">
                    <input id="access-modal-username" type="text" class="form-control form-control-sm"
                           placeholder="Username" autocomplete="off" />
                    <button id="access-modal-grant-btn" type="button" class="btn btn-sm btn-primary">Grant</button>
                </div>

                <p id="access-modal-error" class="text-danger small mt-1" hidden></p>

                <div id="access-modal-user-list" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/checklist-deadline.js" asp-append-version="true"></script>
    <script src="~/js/checklist-sync.js" asp-append-version="true"></script>
    <script src="~/js/author-access.js" asp-append-version="true"></script>
}
