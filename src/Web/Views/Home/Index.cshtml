@{
    ViewData["Title"] = "Home";
    var isAuthed = User.Identity?.IsAuthenticated == true;
}

<section class="bk-hero">
    <h1>Welcome to Bogar Karba</h1>
    <p>Your ultimate technical checklist tracker — plan, share, and finish what matters.</p>

    <div class="bk-hero-actions">
        @if (isAuthed)
        {
            <a class="btn btn-primary" asp-controller="Checklist" asp-action="Create">Create Checklist</a>
            <a class="btn btn-outline-primary" asp-controller="Author" asp-action="Index">My Checklists</a>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Get started</a>
            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Sign in</a>
        }
    </div>
</section>

@if (isAuthed)
{
    <section class="bk-content-card">
        <div class="bk-page-header bk-page-header--flush">
            <h1>Your progress</h1>
            <p>Pick up where you left off.</p>
        </div>
        <div id="progress-checklists-container"></div>
    </section>
}

@section Scripts {
    @if (isAuthed)
    {
        <script src="~/js/home-progress.js" asp-append-version="true"></script>
    }
}
