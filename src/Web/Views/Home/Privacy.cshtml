@{
    ViewData["Title"] = "Privacy Policy";
}

<header class="bk-page-header">
    <h1>@ViewData["Title"]</h1>
    <p>How Bogar Karba handles your data.</p>
</header>

<article class="bk-content-card">
    <h2 class="h4 mb-3">What we store</h2>
    <p>
        Bogar Karba stores the data you provide while creating and sharing checklists —
        including account details (name, surname, email) and the contents of the checklists you author.
    </p>

    <h2 class="h4 mt-4 mb-3">How we use it</h2>
    <p>
        Your data is used solely to operate the service: authenticating you, displaying your
        checklists, and powering collaboration features. We do not sell or share your information
        with third parties for marketing.
    </p>

    <h2 class="h4 mt-4 mb-3">Your control</h2>
    <p>
        You can update your account details at any time. To request deletion of your account
        and the data associated with it, contact the site administrator.
    </p>
</article>
