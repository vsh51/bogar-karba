@model List<AdminUserViewModel>
@{
    ViewData["Title"] = "User Management";
    var searchTerm = ViewData["SearchTerm"] as string;
    var currentAdminId = ViewData["CurrentAdminId"] as string;
}

<div class="bk-container bk-container--medium mt-4 mb-5">
    <div class="bk-page-header bk-page-header--flush d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <div>
            <h1 class="mb-1">User Management</h1>
            <p>Search and manage system users</p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">
            <i class="bi bi-arrow-left me-1"></i> Back to Checklists
        </a>
    </div>

    <form method="get" class="mb-4">
        <div class="input-group shadow-sm">
            <span class="input-group-text bg-white"><i class="bi bi-people"></i></span>
            <input name="searchTerm" value="@searchTerm" class="form-control" placeholder="Search by username..." />
            <button type="submit" class="btn btn-primary px-4">Search</button>
        </div>
    </form>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-secondary-soft">
                    <tr>
                        <th class="ps-4">User</th>
                        <th>Full Name</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                @(string.IsNullOrWhiteSpace(searchTerm)
                                    ? "No users yet."
                                    : $"No users found matching \"{searchTerm}\".")
                            </td>
                        </tr>
                    }
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold">@user.UserName</div>
                                <div class="text-muted small">@user.Email</div>
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(user.FullName))
                                {
                                    <span class="text-muted small fst-italic">Not set</span>
                                }
                                else
                                {
                                    @user.FullName
                                }
                            </td>
                            <td>
                                @if (user.IsBanned)
                                {
                                    <span class="badge bg-danger-soft text-danger">Banned</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-soft text-success">Active</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (!user.IsBanned && user.Id != currentAdminId)
                                {
                                    <form asp-action="BanUser"
                                          asp-route-userId="@user.Id"
                                          asp-route-searchTerm="@searchTerm"
                                          asp-route-fromUsers="true"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to block this user?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Block</button>
                                    </form>
                                }
                                else if (user.Id == currentAdminId)
                                {
                                    <span class="badge bg-primary-soft text-primary">You</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
