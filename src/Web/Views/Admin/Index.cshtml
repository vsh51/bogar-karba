@model List<AdminChecklistViewModel>

@{
    ViewData["Title"] = "Admin Panel";
    var searchTerm = ViewData["SearchTerm"] as string;
}

<div class="bk-container bk-container--narrow mt-4 mb-5">
    <div class="bk-page-header bk-page-header--flush">
        <h1>Admin Panel</h1>
        <p>System management page</p>
    </div>

    <form method="get" class="mb-4">
        <div class="input-group">
            <input name="searchTerm" value="@searchTerm" class="form-control" placeholder="Search..." />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="text-muted small">Search results</div>
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-secondary" asp-controller="Admin" asp-action="Users">Manage Users</a>
            <a class="btn btn-sm btn-outline-primary" asp-controller="Admin" asp-action="Dashboard">System Stats</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-dashed bg-secondary-soft text-center py-5 shadow-sm">
            <div class="card-body">
                <i class="bi bi-search text-muted fs-1 mb-3 d-block"></i>
                <p class="mb-0 text-muted">
                    @(string.IsNullOrWhiteSpace(searchTerm)
                        ? "No checklists yet."
                        : $"No results found for \"{searchTerm}\".")
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="me-auto">
                                <div class="text-muted small mb-1">Author: @item.UserName</div>
                                <div class="fw-bold">
                                    <a href="@Url.Action("Show", "Checklist", new { id = item.Id })" class="text-decoration-none text-dark">@item.Title</a>
                                    @if (!item.IsActive)
                                    {
                                        <span class="badge bg-secondary-soft text-secondary ms-2">inactive</span>
                                    }
                                </div>
                                <div class="text-muted small mt-1">@item.Description</div>
                            </div>

                            <div class="dropdown">
                                <button class="btn btn-link text-muted p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical fs-5"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <form asp-controller="Admin" asp-action="Delete" asp-route-id="@item.Id" asp-route-searchTerm="@searchTerm" method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this checklist?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-trash3 me-2"></i> Delete checklist
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-controller="Admin" asp-action="BanUser" asp-route-userId="@item.UserId" asp-route-searchTerm="@searchTerm" method="post"
                                              onsubmit="return confirm('Are you sure you want to ban this user?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-warning">
                                                <i class="bi bi-slash-circle me-2"></i> Block account
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
