@model Web.Models.Admin.DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="bk-container bk-container--medium mt-4 mb-5">
    <div class="bk-page-header bk-page-header--flush d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-arrow-left me-1"></i> Back to Panel
            </a>
            <div>
                <h1 class="mb-1">Admin Dashboard</h1>
                <p>Welcome, <strong>@User.Identity?.Name</strong>.</p>
            </div>
        </div>

        <form asp-controller="Admin" asp-action="Logout" method="post" class="m-0">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-box-arrow-right me-1"></i> Logout
            </button>
        </form>
    </div>

    <h2 class="h5 mb-3">System overview</h2>
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
            <div class="bk-stat-tile">
                <p class="bk-stat-tile__label">Total checklists</p>
                <p class="bk-stat-tile__value">@Model.TotalChecklists</p>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="bk-stat-tile">
                <p class="bk-stat-tile__label">Total users</p>
                <p class="bk-stat-tile__value">@Model.TotalUsers</p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="bk-stat-tile">
                <p class="bk-stat-tile__label">Published</p>
                <p class="bk-stat-tile__value">@Model.PublishedChecklists</p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="bk-stat-tile">
                <p class="bk-stat-tile__label">Drafts</p>
                <p class="bk-stat-tile__value">@Model.DraftChecklists</p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="bk-stat-tile">
                <p class="bk-stat-tile__label">Archived</p>
                <p class="bk-stat-tile__value">@Model.ArchivedChecklists</p>
            </div>
        </div>
    </div>
</div>
