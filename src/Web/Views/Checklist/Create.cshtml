@using Microsoft.Extensions.Options
@using Application.Options
@inject IOptions<ChecklistOptions> ChecklistOptionsAccessor
@{
    ViewData["Title"] = "Create Checklist";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var maxDate = today.AddYears(ChecklistOptionsAccessor.Value.MaxDeadlineYears);
}

<div class="bk-container bk-container--narrow mt-4 mb-5">
    <div class="bk-page-header bk-page-header--flush">
        <h1>Create new checklist</h1>
        <p>Add items, group them into sections, and set an optional deadline.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4" id="checklist-editor">
                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <label class="form-label">Title</label>
                        <input type="text" class="form-control form-control-lg editable-title" placeholder="e.g. Project Launch Roadmap" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea class="form-control editable-desc" rows="2" placeholder="What is this checklist about? (optional)"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Deadline <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="date" class="form-control editable-deadline"
                               min="@today.ToString("yyyy-MM-dd")"
                               max="@maxDate.ToString("yyyy-MM-dd")" />
                        <div class="form-text">Max @ChecklistOptionsAccessor.Value.MaxDeadlineYears years ahead.</div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Checklist Items</label>
                    <div class="bk-editor-surface">
                        <div class="bk-editor-row">
                            <div class="bk-editor-checkbox"></div>
                            <input type="text" class="bk-editor-input item-input" placeholder="Add a task..." />
                            <button type="button" class="bk-btn-action bk-btn-link" title="Attach link">
                                <i class="bi bi-link-45deg"></i>
                            </button>
                            <button type="button" class="bk-btn-action bk-btn-delete">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-4">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="add-item-btn">
                        <i class="bi bi-plus-lg me-1"></i> Item
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="add-section-btn">
                        <i class="bi bi-list-task me-1"></i> Section
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="add-bored-btn" title="Add a random activity">
                        <i class="bi bi-magic me-1"></i> Random activity
                    </button>
                </div>

                <div class="d-grid gap-3">
                    <button type="button" class="btn btn-primary btn-lg" id="create-checklist-btn">
                        Create Checklist
                    </button>
                    <a asp-controller="Author" asp-action="Index" class="btn btn-link text-decoration-none text-muted">
                        Cancel and go back
                    </a>
                </div>

                @Html.AntiForgeryToken()
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/checklist-create.js" asp-append-version="true"></script>
}
