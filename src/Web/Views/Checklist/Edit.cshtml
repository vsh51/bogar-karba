@model Web.Models.Checklist.EditChecklistViewModel
@using Microsoft.Extensions.Options
@using Application.Options
@inject IOptions<ChecklistOptions> ChecklistOptionsAccessor

@{
    ViewData["Title"] = "Edit Checklist";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var maxDate = today.AddYears(ChecklistOptionsAccessor.Value.MaxDeadlineYears);
}

<div class="bk-container bk-container--narrow mt-4 mb-5">
    <div class="bk-page-header bk-page-header--flush d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <div>
            <h1>Edit checklist</h1>
            <p>Update items, sections, and metadata.</p>
        </div>
        <span class="badge bg-primary-soft text-primary align-self-center">Editor mode</span>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4" id="checklist-editor">
                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <label class="form-label">Title</label>
                        <input type="text" class="form-control form-control-lg editable-title" value="@Model.Title" placeholder="Checklist title" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea class="form-control editable-desc" rows="2" placeholder="Description (optional)">@Model.Description</textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Deadline <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="date" class="form-control editable-deadline"
                               value="@(Model.Deadline?.ToString("yyyy-MM-dd"))"
                               min="@today.ToString("yyyy-MM-dd")"
                               max="@maxDate.ToString("yyyy-MM-dd")" />
                        <div class="form-text">Max @ChecklistOptionsAccessor.Value.MaxDeadlineYears years ahead.</div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-end mb-3">
                        <label class="form-label mb-0">Structure & Items</label>
                        <small class="text-muted">Drag <i class="bi bi-grip-vertical"></i> to reorder tasks</small>
                    </div>

                    <div class="bk-group-tools p-3 mb-3 border rounded bg-light">
                        <div class="row g-2 align-items-center">
                            <div class="col">
                                <input type="text" class="form-control form-control-sm" id="group-section-name" placeholder="New section name..." />
                            </div>
                            <div class="col-auto">
                                <span class="badge bg-white border text-secondary py-2 px-3" id="selected-count">0 selected</span>
                            </div>
                            <div class="col-auto">
                                <button type="button" class="btn btn-primary btn-sm" id="group-selected-btn" disabled>
                                    <i class="bi bi-collection me-1"></i> Group
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="bk-editor-surface" id="sections-container">
                        @foreach (var sectionItem in Model.Sections)
                        {
                            <div class="section-container" data-section-id="@sectionItem.Id">
                                <div class="bk-editor-row bk-editor-row-section">
                                    <input type="text" class="bk-editor-input bk-editor-input-section section-input" value="@sectionItem.Name" placeholder="Section name..." />
                                    <button type="button" class="bk-btn-action bk-btn-delete btn-delete-section">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                                <div class="tasks-container">
                                    @foreach (var task in sectionItem.Tasks)
                                    {
                                        <div class="bk-editor-row task-row" data-task-id="@task.Id" draggable="true">
                                            <div class="bk-drag-handle me-1">
                                                <i class="bi bi-grip-vertical"></i>
                                            </div>
                                            <div class="form-check mb-0 me-2">
                                                <input type="checkbox" class="form-check-input select-task" />
                                            </div>
                                            <input type="text" class="bk-editor-input item-input" value="@task.Content" placeholder="Task description..." />
                                            <button type="button" class="bk-btn-action bk-btn-link @(!string.IsNullOrWhiteSpace(task.Link) ? "has-link" : "")" title="Attach link">
                                                <i class="bi bi-link-45deg"></i>
                                            </button>
                                            <button type="button" class="bk-btn-action bk-btn-delete btn-delete-task">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(task.Link))
                                        {
                                            <div class="bk-link-input-wrapper">
                                                <input type="url" class="bk-link-input link-url-input" value="@task.Link" placeholder="https://..." />
                                            </div>
                                        }
                                    }
                                </div>
                                <div class="bk-editor-row-add p-2 bg-white border-top border-bottom-0">
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control border-0 bg-light add-item-input" placeholder="+ Add item to this section..." />
                                        <button class="btn btn-outline-success border-0 btn-add-confirm" type="button">Add</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-grid gap-3">
                    <button type="button" class="btn btn-primary btn-lg" id="save-checklist-btn">
                        Save All Changes
                    </button>
                    <a asp-controller="Author" asp-action="Index" class="btn btn-link text-decoration-none text-muted">
                        Discard changes
                    </a>
                </div>

                @Html.AntiForgeryToken()
        </div>
    </div>
</div>

<div class="toast-stack" id="toast-stack" aria-live="polite" aria-atomic="true"></div>

@section Scripts {
    <script>
        window.checklistId = '@ViewData["ChecklistId"]';
    </script>
    <script src="~/js/checklist-edit.js" asp-append-version="true"></script>
}
