@model Web.Models.Checklist.ChecklistViewModel
@using System.Text.Json

@{
    ViewData["Title"] = Model.Title;
}

@* Styles moved to wwwroot/css/components.css *@

<section class="bk-checklist checklist-page"
         data-checklist-id="@Model.Id"
         data-server-progress-url="@(Model.IsOwner && !Model.IsPublic ? Url.Action("SaveProgress", "Checklist", new { id = Model.Id }) : string.Empty)"
         data-initial-completed-task-ids='@JsonSerializer.Serialize(Model.InitialCompletedTaskIds)'>
    <div class="checklist-toolbar">
        <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Options
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <button id="copy-md-btn" class="dropdown-item" type="button">
                        Copy as Markdown
                    </button>
                </li>
                @if (Model.IsPublic && Model.IsEmbeddable)
                {
                    <li>
                        <button id="export-iframe-btn" class="dropdown-item" type="button">
                            Export as Iframe
                        </button>
                    </li>
                }
                <li><hr class="dropdown-divider"></li>
                <li>
                    <button id="export-progress-btn" class="dropdown-item" type="button">
                        Export Progress
                    </button>
                </li>
                <li>
                    <button id="import-progress-btn" class="dropdown-item" type="button">
                        Import Progress
                    </button>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <button id="share-progress-btn" class="dropdown-item" type="button" onclick="window.checklistProgressSync.copyShareLinkToClipboard('@Model.Id')">
                        Share Progress Link
                    </button>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <button id="clear-progress-btn" class="dropdown-item text-danger" type="button">
                        Clear Progress
                    </button>
                </li>
            </ul>
        </div>
        <input type="file" id="import-progress-file" accept=".json" class="d-none" />
    </div>

    @if (Model.IsPublic && Model.IsEmbeddable)
    {
        var embedUrl = Url.Action("Embed", "Checklist", new { id = Model.Id }, Context.Request.Scheme);
        <div class="modal fade" id="embedIframeModal" tabindex="-1" aria-labelledby="embedIframeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="embedIframeModalLabel">Embed Checklist</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-2">Copy and paste this snippet into any HTML page to embed this checklist.</p>
                        <textarea id="embed-iframe-snippet" class="form-control" rows="4" readonly>&lt;iframe src="@embedUrl" width="100%" height="600" frameborder="0" loading="lazy"&gt;&lt;/iframe&gt;</textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" id="embed-iframe-copy-btn">Copy snippet</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="checklist-progress" aria-live="polite">
        <div class="checklist-progress-meta">
            <span class="checklist-progress-percent" data-progress-percent>0%</span>
            <span data-progress-count>0/0</span>
        </div>
        <div
            class="checklist-progress-bar-wrap"
            role="progressbar"
            aria-label="Checklist completion"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            data-progress-bar-wrap>
            <div class="checklist-progress-bar" data-progress-bar></div>
        </div>
    </div>

    <section class="checklist-timer" aria-live="polite">
        <div class="checklist-timer-header">
            <p class="checklist-timer-label">Completion Timer</p>
            <span class="checklist-timer-state" data-timer-state>Stopped</span>
        </div>

        <div class="checklist-timer-value" data-timer-display>00:00:00</div>

        <div class="checklist-timer-actions">
            <button type="button" class="btn btn-sm btn-outline-success" data-timer-start>
                Start
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-timer-stop>
                Stop
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger" data-timer-restart>
                Restart
            </button>
        </div>
    </section>

    <header class="mb-3">
        <h1 class="checklist-title">@Model.Title</h1>

        @if (Model.Deadline.HasValue)
        {
            var deadlineIso = Model.Deadline.Value.ToString("yyyy-MM-dd");
            <div class="checklist-deadline @(Model.IsOutdated ? "is-outdated" : null)"
                 title="Deadline">
                <i class="bi bi-calendar-event" aria-hidden="true"></i>
                <time datetime="@deadlineIso" data-deadline="@deadlineIso">@Model.Deadline.Value.ToString("yyyy-MM-dd")</time>
                <span class="checklist-deadline-remaining">· @Model.DeadlineRemaining</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="checklist-description">@Model.Description</p>
        }
    </header>

    @if (Model.Sections.Any())
    {
        int secIndex = 0;
        @foreach (var sec in Model.Sections.OrderBy(s => s.Position))
        {
            var collapseId = $"collapse-sec-{secIndex++}";
            <article class="checklist-section">
                <div class="checklist-section-header" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="true" aria-controls="@collapseId">
                    <i class="bi bi-chevron-down checklist-section-toggle"></i>
                    <h2 class="checklist-section-title">@sec.Name</h2>
                </div>

                <div class="collapse show" id="@collapseId">
                    <div class="checklist-collapse-body">
                        @if (sec.Items.Any())
                        {
                            <ul class="checklist-items">
                                @foreach (var item in sec.Items)
                                {
                                    var itemId = $"item-{item.Id}";

                                    <li class="checklist-item">
                                        <input id="@itemId" type="checkbox" class="form-check-input checklist-item-input" data-task-id="@item.Id" />
                                        <label for="@itemId" class="checklist-item-label">
                                            @item.Content
                                            @if (!string.IsNullOrWhiteSpace(item.Link))
                                            {
                                                var linkLabel = Uri.TryCreate(item.Link, UriKind.Absolute, out var uri) ? uri.Host : "link";
                                                <a href="@item.Link" class="checklist-item-link" target="_blank" rel="noopener noreferrer">
                                                    <span class="checklist-item-link-icon">&#128279;</span>@linkLabel
                                                </a>
                                            }
                                        </label>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="checklist-empty">No items in this section yet.</p>
                        }
                    </div>
                </div>
            </article>
        }
    }
    else
    {
        <p class="checklist-empty">This checklist does not contain any sections yet.</p>
    }

    @if (Model.IsOwner && !Model.IsPublic)
    {
        <section id="access-management-panel" class="access-management" data-checklist-id="@Model.Id">
            <h2 class="access-management-title">Access Management</h2>
            <p class="access-management-subtitle">Grant other users access to this private checklist by their username.</p>

            @Html.AntiForgeryToken()

            <div class="access-grant-row">
                <input id="access-username-input" type="text" class="form-control form-control-sm"
                       placeholder="Username" autocomplete="off" />
                <button id="access-grant-btn" type="button" class="btn btn-sm btn-primary">Grant</button>
            </div>

            <p id="access-error" class="access-error" hidden></p>

            <div id="access-user-list"></div>
        </section>
    }
</section>

@section Scripts {
    <script src="~/js/checklist-progress.js" asp-append-version="true"></script>
    <script src="~/js/checklist-export.js" asp-append-version="true"></script>
    <script src="~/js/checklist-embed.js" asp-append-version="true"></script>
    <script src="~/js/checklist-sync.js" asp-append-version="true"></script>
    <script src="~/js/checklist-deadline.js" asp-append-version="true"></script>
    <script src="~/js/checklist-timer.js" asp-append-version="true"></script>
    @if (Model.IsOwner && !Model.IsPublic)
    {
        <script src="~/js/checklist-access.js" asp-append-version="true"></script>
    }
}
