@{
    var currentYear = DateTime.UtcNow.Year;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bogar Karba</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <environment include="Development">
        <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/bundle.min.css" asp-append-version="true" />
    </environment>

    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="bk-navbar navbar navbar-expand-lg" aria-label="Primary">
            <div class="bk-container bk-navbar-inner">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Bogar Karba</a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#bk-primary-nav"
                        aria-controls="bk-primary-nav"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="bk-primary-nav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-lg-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Checklist" asp-action="Create">Create Checklist</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Author" asp-action="Index">My Checklists</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Checklist" asp-action="Shared">Shared with me</a>
                            </li>
                            <li class="nav-item dropdown">
                                <button id="notification-bell"
                                        class="bk-bell"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        aria-label="Notifications">
                                    Notifications
                                    <span id="notification-badge"
                                          class="bk-bell-badge d-none"
                                          aria-hidden="true"></span>
                                </button>
                                <ul id="notification-list" class="dropdown-menu dropdown-menu-end bk-bell-list">
                                    <li class="dropdown-item text-muted small">No notifications</li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <span class="bk-user-name" title="@User.Identity.Name">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="nav-link">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        <div class="bk-container">
            @if (TempData["SuccessMessage"] is string successMsg)
            {
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    @successMsg
                    <button type="button" class="btn-close" data-bs-alert="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["WarningMessage"] is string warningMsg)
            {
                <div class="alert alert-warning alert-dismissible fade show mt-3" role="alert">
                    @warningMsg
                    <button type="button" class="btn-close" data-bs-alert="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] is string errorMsg)
            {
                <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                    @errorMsg
                    <button type="button" class="btn-close" data-bs-alert="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <footer class="bk-footer">
        <div class="bk-container">
            <p class="bk-footer-text">&copy; @currentYear Bogar Karba — Technical checklist tracker.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <environment include="Development">
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="~/js/ui.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/bundle.min.js" asp-append-version="true"></script>
    </environment>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/lib/signalr/signalr.min.js"></script>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
